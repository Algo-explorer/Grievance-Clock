# Copy to .env.local. Never commit secrets.
# Account access defaults to Clerk. AUTH_MODE=local is only for isolated local testing.
AUTH_MODE=clerk
APP_ENV=development
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_ISSUER_URL=
MONGODB_URI=
MONGODB_DATABASE=grievance_clock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
AI_MODE=live
# Run python -m scripts.setup_local_voice once to enable no-key local transcription.
# Multilingual small improves accuracy over base. Use medium on a faster machine.
LOCAL_WHISPER_MODEL=small
# Optional override; defaults to data/models/whisper-small inside this project.
LOCAL_WHISPER_PATH=
# Run python -m scripts.setup_local_tts for dedicated offline Hindi playback.
LOCAL_HINDI_VOICE_PATH=
BACKEND_URL=http://127.0.0.1:8000
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
COOKIE_SECURE=false
# Generate a Fernet key for hosting. Locally a key is generated in ignored data/.
DATA_ENCRYPTION_KEY=
DATA_DIR=data
# Optional teammate API; called only after the user opts in.
FRAUD_API_URL=
FRAUD_API_TOKEN=
